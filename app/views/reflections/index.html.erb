<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
  <div>
    <h1 class="h2">🪞 Reflections</h1>
    <p class="text-muted mb-0"><%= @reflections.count %> reflections</p>
  </div>
  <%= link_to "＋ New Reflection", new_reflection_path, class: "btn btn-primary" %>
</div>

<div class="row g-4">
  <% @reflections.each do |reflection| %>
    <div class="col-12 col-lg-6">
      <%= render reflection %>
    </div>
  <% end %>
</div>
