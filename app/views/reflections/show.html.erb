<%= render @reflection %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this reflection", edit_reflection_path(@reflection), class: "btn btn-primary" %>
  <%= link_to "Back to reflections", reflections_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this reflection", @reflection, method: :delete, class: "btn btn-outline-danger" %>
</div>
