<%= form_with(model: reflection) do |form| %>
  <%= render "layouts/shared/form_errors", record: reflection, resource_name: "reflection" %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= form.label :place, class: "form-label" %>
    <%= form.text_field :place, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= form.label :nature, class: "form-label" %>
    <%= form.select :nature, Reflection.natures.keys.map { |type| [type.humanize, type] }, {}, class: 'form-select' %>
  </div>

  <div class="mb-3">
    <%= form.label :content, class: "form-label" %>
    <%= form.cktext_area :content, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :action, class: "form-label" %>
    <%= form.cktext_area :action, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
