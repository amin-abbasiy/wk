<%= form_with(model: reflection) do |form| %>
  <% if reflection.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(reflection.errors.count, "error") %> prohibited this reflection from being saved:</h2>

      <ul>
        <% reflection.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :place, style: "display: block" %>
    <%= form.text_field :place, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :nature, style: "display: block" %>
    <%= form.select :nature, Reflection.natures.keys.map { |type| [type.humanize, type] }, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.cktext_area :content %>
  </div>

  <div>
    <%= form.label :action, style: "display: block" %>
    <%= form.cktext_area :action %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
