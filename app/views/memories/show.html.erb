<%= render @memory %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this memory", edit_memory_path(@memory), class: "btn btn-primary" %>
  <%= link_to "Back to memories", memories_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this memory", @memory, method: :delete, class: "btn btn-outline-danger" %>
</div>
