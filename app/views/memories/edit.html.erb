<%= render layout: "layouts/shared/form_page" do %>
  <h1 class="h2 fw-bold mb-4">Editing memory</h1>

  <%= render "form", memory: @memory %>

  <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
    <%= link_to "Show this memory", @memory, class: "btn btn-outline-primary" %>
    <%= link_to "Back to memories", memories_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
