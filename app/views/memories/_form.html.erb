<%= form_with(model: memory) do |form| %>
  <%= render "layouts/shared/form_errors", record: memory, resource_name: "memory" %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :content, class: "form-label" %>
    <%= form.cktext_area :content, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :picture, class: "form-label" %>
    <%= form.file_field :picture, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :video, class: "form-label" %>
    <%= form.file_field :video, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :feeling, class: "form-label" %>
    <%= form.cktext_area :feeling, class: "form-control", rows: "5", ckeditor: { language: 'uk'}  %>
  </div>

  <div class="mb-3">
    <%= form.label :lessons, class: "form-label" %>
    <%= form.cktext_area :lessons, class: "form-control", rows: "5", ckeditor: { language: 'uk'}  %>
  </div>

  <div class="mb-3">
    <%= form.label :use_cases, class: "form-label" %>
    <%= form.cktext_area :use_cases, class: "form-control", rows: "5", ckeditor: { language: 'uk'}  %>
  </div>

  <div class="mb-3">
    <%= form.label :channeling_ways, class: "form-label" %>
    <%= form.cktext_area :channeling_ways, class: "form-control", rows: "5", ckeditor: { language: 'uk'}  %>
  </div>

  <div class="mb-3">
    <%= form.label :dangers, class: "form-label" %>
    <%= form.cktext_area :dangers, class: "form-control", rows: "5", ckeditor: { language: 'uk'}  %>
  </div>

  <div class="mb-3">
    <%= form.label :conclusions, for: 'conclusions', class: 'form-label' %>
    <%= form.cktext_area :conclusions, class: "form-control", id: 'conclusions', rows: "5", ckeditor: { language: 'uk'}  %>
  </div>

  <div class="mb-3">
    <%= form.label :repeated, class: "form-label" %>
    <%= form.number_field :repeated, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
