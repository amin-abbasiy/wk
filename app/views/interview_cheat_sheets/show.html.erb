<p style="color: green"><%= notice %></p>

<%= render @interview_cheat_sheet %>

<div>
  <%= link_to "Edit this interview cheat sheet", edit_interview_cheat_sheet_path(@interview_cheat_sheet), class: 'btn btn-warning' %> |
