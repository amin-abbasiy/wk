<%= render @interview_cheat_sheet %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this interview cheat sheet", edit_interview_cheat_sheet_path(@interview_cheat_sheet), class: "btn btn-primary" %>
  <%= link_to "Back to interview cheat sheets", interview_cheat_sheets_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this interview cheat sheet", @interview_cheat_sheet, method: :delete, class: "btn btn-outline-danger" %>
</div>
