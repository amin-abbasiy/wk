<%= form_with(model: interview_cheat_sheet) do |form| %>
  <%= render "layouts/shared/form_errors", record: interview_cheat_sheet, resource_name: "interview_cheat_sheet" %>

  <div class="mb-3">
    <%= form.label :date, class: "form-label" %>
    <%= form.datetime_field :date, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :location, class: "form-label" %>
    <%= form.text_field :location, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :company, class: "form-label" %>
    <%= form.text_field :company, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :positon, class: "form-label" %>
    <%= form.text_field :positon, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :interviewers, class: "form-label" %>
    <%= form.cktext_area :interviewers, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :company_info, class: "form-label" %>
    <%= form.cktext_area :company_info, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :my_pitch, class: "form-label" %>
    <%= form.cktext_area :my_pitch, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div class="mb-3">
    <%= form.label :accomplishments_skills, class: "form-label" %>
    <%= form.cktext_area :accomplishments_skills, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div class="mb-3">
    <%= form.label :reason_about_position, class: "form-label" %>
    <%= form.cktext_area :reason_about_position, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div class="mb-3">
    <%= form.label :my_questions, class: "form-label" %>
    <%= form.cktext_area :my_questions, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div class="mb-3">
    <%= form.label :predicted_question_answers, class: "form-label" %>
    <%= form.cktext_area :predicted_question_answers, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div class="mb-3">
    <%= form.label :my_first_impression, class: "form-label" %>
    <%= form.cktext_area :my_first_impression, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div class="mb-3">
    <%= form.label :result, class: "form-label" %>
    <%= form.cktext_area :result, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
