<%= form_with(model: interview_cheat_sheet) do |form| %>
  <% if interview_cheat_sheet.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(interview_cheat_sheet.errors.count, "error") %> prohibited this interview_cheat_sheet from being saved:</h2>

      <ul>
        <% interview_cheat_sheet.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :date, style: "display: block" %>
    <%= form.datetime_field :date %>
  </div>

  <div>
    <%= form.label :location, style: "display: block" %>
    <%= form.text_field :location %>
  </div>

  <div>
    <%= form.label :company, style: "display: block" %>
    <%= form.text_field :company %>
  </div>

  <div>
    <%= form.label :positon, style: "display: block" %>
    <%= form.text_field :positon %>
  </div>

  <div>
    <%= form.label :interviewers, style: "display: block" %>
    <%= form.cktext_area :interviewers %>
  </div>

  <div>
    <%= form.label :company_info, style: "display: block" %>
    <%= form.cktext_area :company_info %>
  </div>

  <div>
    <%= form.label :my_pitch, style: "display: block" %>
    <%= form.cktext_area :my_pitch, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div>
    <%= form.label :accomplishments_skills, style: "display: block" %>
    <%= form.cktext_area :accomplishments_skills, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div>
    <%= form.label :reason_about_position, style: "display: block" %>
    <%= form.cktext_area :reason_about_position, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div>
    <%= form.label :my_questions, style: "display: block" %>
    <%= form.cktext_area :my_questions, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div>
    <%= form.label :predicted_question_answers, style: "display: block" %>
    <%= form.cktext_area :predicted_question_answers, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div>
    <%= form.label :my_first_impression, style: "display: block" %>
    <%= form.cktext_area :my_first_impression, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div>
    <%= form.label :result, style: "display: block" %>
    <%= form.cktext_area :result, class: "form-control", rows: "5", ckeditor: { language: 'uk'} %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
