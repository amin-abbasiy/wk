<%= render layout: "layouts/shared/form_page" do %>
  <h1 class="h2 fw-bold mb-4">Editing interview cheat sheet</h1>

  <%= render "form", interview_cheat_sheet: @interview_cheat_sheet %>

  <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
    <%= link_to "Show this interview cheat sheet", @interview_cheat_sheet, class: "btn btn-outline-primary" %>
    <%= link_to "Back to interview cheat sheets", interview_cheat_sheets_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
