<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
  <h1 class="h2 mb-0">Stories</h1>
  <%= link_to "New story", new_story_path, class: "btn btn-primary" %>
</div>

<div id="stories" class="vstack gap-4">
  <% @stories.each do |story| %>
    <div>
      <%= render story %>
      <p class="mt-2 mb-0">
        <%= link_to "Show this story", story, class: "btn btn-outline-primary btn-sm" %>
      </p>
    </div>
  <% end %>
</div>
