<%= render layout: "layouts/shared/form_page" do %>
  <h1 class="h2 fw-bold mb-4">Editing story</h1>

  <%= render "form", story: @story %>

  <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
    <%= link_to "Show this story", @story, class: "btn btn-outline-primary" %>
    <%= link_to "Back to stories", stories_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
