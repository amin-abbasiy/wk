<%= render @story %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this story", edit_story_path(@story), class: "btn btn-primary" %>
  <%= link_to "Back to stories", stories_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this story", @story, method: :delete, class: "btn btn-outline-danger" %>
</div>
