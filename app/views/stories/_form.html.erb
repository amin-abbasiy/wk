<%= form_with(model: story) do |form| %>
  <%= render "layouts/shared/form_errors", record: story, resource_name: "story" %>

  <div class="mb-3">
    <%= form.label :nugget, class: "form-label" %>
    <%= form.cktext_area :nugget, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :situation, class: "form-label" %>
    <%= form.cktext_area :situation, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :action, class: "form-label" %>
    <%= form.cktext_area :action, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :result, class: "form-label" %>
    <%= form.cktext_area :result, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
