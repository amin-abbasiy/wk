<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
  <h1 class="h2 mb-0">Frustrations</h1>
  <%= link_to "New frustration", new_frustration_path, class: "btn btn-primary" %>
</div>

<div id="frustrations" class="vstack gap-4">
  <% @frustrations.each do |frustration| %>
    <div>
      <%= render frustration %>
      <p class="mt-2 mb-0">
        <%= link_to "Show this frustration", frustration, class: "btn btn-outline-primary btn-sm" %>
      </p>
    </div>
  <% end %>
</div>
