<%= form_with(model: frustration) do |form| %>
  <%= render "layouts/shared/form_errors", record: frustration, resource_name: "frustration" %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :content, class: "form-label" %>
    <%= form.cktext_area :content, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :trash_them, class: "form-label" %>
    <%= form.cktext_area :trash_them, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :reasons, class: "form-label" %>
    <%= form.cktext_area :reasons, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :channeling_techniques, class: "form-label" %>
    <%= form.cktext_area :channeling_techniques, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :created_purposes, class: "form-label" %>
    <%= form.cktext_area :created_purposes, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :goals_for_purposes, class: "form-label" %>
    <%= form.cktext_area :goals_for_purposes, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :action_plan, class: "form-label" %>
    <%= form.cktext_area :action_plan, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :emotions_after_action, class: "form-label" %>
    <%= form.cktext_area :emotions_after_action, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :result_of_emotions, class: "form-label" %>
    <%= form.cktext_area :result_of_emotions, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :resule_of_action, class: "form-label" %>
    <%= form.cktext_area :resule_of_action, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :catchphrase, class: "form-label" %>
    <%= form.text_field :catchphrase, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
