<%= render @frustration %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this frustration", edit_frustration_path(@frustration), class: "btn btn-primary" %>
  <%= link_to "Back to frustrations", frustrations_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this frustration", @frustration, method: :delete, class: "btn btn-outline-danger" %>
</div>
