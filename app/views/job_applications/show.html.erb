<div class="container py-4">
  <%= render @application, single_show: true %>

  <div class="d-flex flex-wrap align-items-center gap-2 pt-3 border-top">
    <%= link_to 'Edit application', edit_job_application_path(@application), class: 'btn btn-primary rounded-pill px-3' %>
    <%= link_to '← Back to applications', job_applications_path, class: 'btn btn-outline-secondary rounded-pill px-3' %>
    <%= button_to 'Delete application', @application, method: :delete,
                  class: 'btn btn-outline-danger rounded-pill px-3',
                  form: { class: 'ms-sm-auto', data: { turbo_confirm: 'Delete this application? This cannot be undone.' } } %>
  </div>
</div>
