<p style="color: green"><%= notice %></p>

<%= render @application, single_show: true %>

<div>
  <%= link_to "Edit this application", edit_job_application_path(@application), class: 'btn btn-warning' %> |
  <%= link_to "Back to applications", job_applications_path, class: 'btn btn-success' %>

  <%= button_to "Destroy this application", @application, method: :delete, class: 'btn btn-danger' %>
</div>
