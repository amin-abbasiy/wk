<h1 class="h2 fw-bold mb-4">Applications</h1>

<div class="row">
  <div class="col-12 col-lg-6 col-xl-4">
    <%= form_with url: job_applications_path, method: :get, class: "d-flex gap-2 mb-3", role: "search" do |form| %>
      <%= hidden_field_tag :filter_status, params[:filter_status] if params[:filter_status].present? %>
      <%= form.search_field :query, value: @query, placeholder: "Search by company name...", class: "form-control", aria: { label: "Search by company name" } %>
      <%= form.submit "Search", class: "btn btn-primary" %>
      <%= link_to "Clear", job_applications_path(filter_status: params[:filter_status]), class: "btn btn-outline-secondary" if @query.present? %>
    <% end %>
  </div>
</div>

<div class="d-flex flex-wrap align-items-center gap-2 py-3 border-bottom">
  <%= link_to "+ New application", new_job_application_path, class: 'btn btn-primary rounded-pill px-3' %>

  <div class="dropdown">
    <button class="btn btn-outline-secondary rounded-pill dropdown-toggle" type="button" id="applicationFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
      <%= params[:filter_status].presence&.humanize || 'All statuses' %>
    </button>
    <div class="dropdown-menu shadow-sm border-0 rounded-3" aria-labelledby="applicationFilterDropdown">
      <%= link_to "All statuses", job_applications_path(query: @query), class: "dropdown-item #{'active' if params[:filter_status].blank?}" %>
      <% JobApplication.statuses.each_key do |status| %>
        <%= link_to status.humanize, job_applications_path(filter_status: status, query: @query), class: "dropdown-item #{'active' if params[:filter_status] == status}" %>
      <% end %>
    </div>
  </div>

  <div class="dropdown">
    <button class="btn btn-light rounded-pill dropdown-toggle" type="button" id="applicationStatsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
      Statistics
    </button>
    <div class="dropdown-menu shadow-sm border-0 rounded-3 overflow-auto" style="max-height: 60vh;" aria-labelledby="applicationStatsDropdown">
      <h3 class="dropdown-header">Overview</h3>
      <span class="dropdown-item-text text-nowrap">Results: <%= @all %></span>
      <span class="dropdown-item-text text-nowrap">Landed interview: <%= @landed %></span>
      <span class="dropdown-item-text text-nowrap">Landed ratio: <%= number_to_percentage(@landed_ratio * 100, precision: 2) %></span>
      <span class="dropdown-item-text text-nowrap">In progress: <%= @in_progress %></span>
      <span class="dropdown-item-text text-nowrap">Interviewing: <%= @interviewing %></span>
      <span class="dropdown-item-text text-nowrap">Rejected: <%= @rejected %></span>
      <hr class="dropdown-divider">
      <h3 class="dropdown-header">Monthly landings</h3>
      <% JobApplication.months_landed.each do |month, landed| %>
        <span class="dropdown-item-text"><%= Date::ABBR_MONTHNAMES[month] %>: <%= landed %></span>
      <% end %>
      <hr class="dropdown-divider">
      <h3 class="dropdown-header">Weekly applications</h3>
      <% JobApplication.week_applied.each do |week, applied| %>
        <span class="dropdown-item-text">Week <%= week %>: <%= applied %></span>
      <% end %>
    </div>
  </div>
</div>

<div class="mt-4">
  <% if @applications.empty? %>
    <div class="bg-light rounded-4 text-center p-4 p-md-5">
      <% if @query.present? || params[:filter_status].present? %>
        <h2 class="h5 mb-2">No matching applications</h2>
        <p class="text-muted mb-3"><%= @query.present? ? 'No applications match this company name.' : 'No applications match this status.' %></p>
        <%= link_to 'Clear filters', job_applications_path, class: 'btn btn-outline-secondary rounded-pill' %>
      <% else %>
        <h2 class="h5 mb-2">No applications yet</h2>
        <p class="text-muted mb-3">Add your first application to start tracking your progress.</p>
        <%= link_to '+ New application', new_job_application_path, class: 'btn btn-primary rounded-pill' %>
      <% end %>
    </div>
  <% end %>
  <div class="row">
    <% @applications.each do |job_application| %>
      <%= render partial: 'job_application', locals: { job_application: job_application } %>
    <% end %>
  </div>
</div>

<% if @status_chart_data.any? { |_, count| count.positive? } %>
  <section class="card border-0 shadow-sm rounded-4 mt-4" aria-labelledby="status-chart-title">
    <div class="card-body p-3 p-md-4">
      <h2 id="status-chart-title" class="h5 mb-1">Applications by status</h2>
      <p class="text-muted small mb-3">All your applications, grouped by their current status.</p>
      <%= tag.div id: "application-status-chart",
                  style: "height: #{@status_chart_data.length * 48 + 64}px;",
                  data: {
                    controller: "status-chart",
                    status_chart_data_value: @status_chart_data,
                    status_chart_colors_value: @status_chart_colors
                  } %>
      <details class="mt-3 small text-muted">
        <summary>View counts as a table</summary>
        <table class="table table-sm mt-2">
          <caption class="visually-hidden">Application counts by status</caption>
          <thead><tr><th scope="col">Status</th><th scope="col">Count</th></tr></thead>
          <tbody>
            <% @status_chart_data.each do |status, count| %>
              <tr><th scope="row"><%= status %></th><td><%= count %></td></tr>
            <% end %>
          </tbody>
        </table>
      </details>
    </div>
  </section>
<% end %>
