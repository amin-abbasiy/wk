<% if record.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <h2 class="h6"><%= pluralize(record.errors.count, "error") %> prohibited this <%= resource_name %> from being saved:</h2>
    <ul class="mb-0">
      <% record.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
