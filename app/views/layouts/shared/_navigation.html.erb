<nav class="navbar navbar-expand-lg app-navbar sticky-top" aria-label="Main navigation">
  <div class="container">
    <a class="navbar-brand fw-bold" href="<%= root_path %>">
      <span aria-hidden="true">🎳</span> The Dude
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavDropdown">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
        <li class="nav-item">
          <%= link_to 'Applications', job_applications_path, class: "nav-link #{'active' if controller_name == 'job_applications'}", aria: { current: ('page' if controller_name == 'job_applications') } %>
        </li>
        <% { 'Career' => %w[interview_cheat_sheets email_messages my_offers],
             'Planning' => %w[weekly_plans tasks],
             'Notes & learning' => %w[topics memories stories learnings reflections auto_suggestions flashcards englishes frustrations shift_shames] }.each_pair do |name, group| %>
          <li class="nav-item dropdown">
            <button class="nav-link dropdown-toggle <%= 'active' if group.include?(controller_name) %>" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <%= name %>
            </button>
            <ul class="dropdown-menu">
              <% group.each do |model| %>
                <li><%= link_to model.humanize, public_send("#{model}_path"), class: "dropdown-item #{'active' if controller_name == model}", aria: { current: ('page' if controller_name == model) } %></li>
              <% end %>
            </ul>
          </li>
        <% end %>

        <% if user_signed_in? %>
          <li class="nav-item dropdown ms-lg-3">
            <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              Account
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><%= link_to 'Profile', user_path(current_user), class: 'dropdown-item' %></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to 'Sign out', destroy_user_session_path, method: :delete, class: 'dropdown-item text-danger' %>
              </li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item ms-lg-3">
            <%= link_to 'Sign in', new_user_session_path, class: 'nav-link' %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
