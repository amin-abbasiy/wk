<%= render layout: "layouts/shared/form_page" do %>
  <h1 class="h2 fw-bold mb-4">Editing weekly plan</h1>

  <%= render "form", weekly_plan: @weekly_plan %>

  <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
    <%= link_to "Show this weekly plan", @weekly_plan, class: "btn btn-outline-primary" %>
    <%= link_to "Back to weekly plans", weekly_plans_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
