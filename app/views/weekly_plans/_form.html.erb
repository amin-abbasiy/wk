<%= form_with(model: weekly_plan) do |form| %>
  <%= render "layouts/shared/form_errors", record: weekly_plan, resource_name: "weekly_plan" %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= form.label :week, class: "form-label" %>
    <%= form.number_field :week, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :nature, class: "form-label" %>
    <%= form.select :nature, WeeklyPlan.natures.map { |key, value| [key.humanize, value] }, {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :notes, class: "form-label" %>
    <%= form.cktext_area :notes, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :reflect, class: "form-label" %>
    <%= form.cktext_area :reflect, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :actions, class: "form-label" %>
    <%= form.cktext_area :actions, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :ideas, class: "form-label" %>
    <%= form.cktext_area :ideas, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
