<div class="mb-4">
  <%= render @weekly_plan %>
</div>

<% @weekly_plan.tasks.each do |task| %>
  <div class="table-responsive">
    <table class="table table-bordered align-middle">
      <thead>
        <tr>
          <th scope="col">Task</th>
          <th scope="col">status</th>
          <th scope="col">Time</th>
          <th scope="col">Interval</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row"><%= task.name %></th>
          <td><%= task.status %></td>
          <td><%= "#{task.start_time.strftime("%R")} - #{task.end_time.strftime("%R")}" %></td>
          <td><%= task.interval %></td>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this weekly plan", edit_weekly_plan_path(@weekly_plan), class: "btn btn-primary" %>
  <%= link_to "Back to weekly plans", weekly_plans_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this weekly plan", @weekly_plan, method: :delete, class: "btn btn-outline-danger" %>
</div>
