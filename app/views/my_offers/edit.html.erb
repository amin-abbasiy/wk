<%= render layout: "layouts/shared/form_page" do %>
  <h1 class="h2 fw-bold mb-4">Editing my offer</h1>

  <%= render "form", my_offer: @my_offer %>

  <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
    <%= link_to "Show this my offer", @my_offer, class: "btn btn-outline-primary" %>
    <%= link_to "Back to my offers", my_offers_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
