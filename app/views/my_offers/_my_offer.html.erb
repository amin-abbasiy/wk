<div class="card h-100 shadow-sm">
  <div class="card-body" id="<%= dom_id my_offer %>">
    <p>
      <strong>Title:</strong>
      <%= my_offer.title %>
    </p>

    <div class="mb-3">
      <strong>Story:</strong>
      <%= my_offer.story.html_safe %>
    </div>

    <div class="mb-3">
      <strong>Present:</strong>
      <%= my_offer.present.html_safe %>
    </div>

    <div class="mt-3">
      <%= link_to "Show this my offer", my_offer, class: "btn btn-outline-primary btn-sm" %>
    </div>
  </div>
</div>
