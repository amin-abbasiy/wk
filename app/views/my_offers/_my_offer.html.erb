<div class="col-md-6 mb-4">
  <div class="card">
    <div class="card-body">
      <div id="<%= dom_id my_offer %>">
        <p>
          <strong>Title:</strong>
          <%= my_offer.title %>
        </p>

        <p>
          <strong>Story:</strong>
          <%= my_offer.story.html_safe %>
        </p>

        <p>
          <strong>Present:</strong>
          <%= my_offer.present.html_safe %>
        </p>

        <p><%= link_to "Show this my offer", my_offer %></p>
      </div>
    </div>
  </div>
</div>