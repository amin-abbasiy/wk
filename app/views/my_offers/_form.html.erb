<%= form_with(model: my_offer) do |form| %>
  <% if my_offer.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(my_offer.errors.count, "error") %> prohibited this my_offer from being saved:</h2>

      <ul>
        <% my_offer.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title, class: 'form-control' %>
  </div>

  <div>
    <%= form.label :story, style: "display: block" %>
    <%= form.cktext_area :story %>
  </div>

  <div>
    <%= form.label :present, style: "display: block" %>
    <%= form.cktext_area :present %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
