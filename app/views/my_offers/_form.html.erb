<%= form_with(model: my_offer) do |form| %>
  <%= render "layouts/shared/form_errors", record: my_offer, resource_name: "my_offer" %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= form.label :story, class: "form-label" %>
    <%= form.cktext_area :story, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :present, class: "form-label" %>
    <%= form.cktext_area :present, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
