<%= render @my_offer %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this my offer", edit_my_offer_path(@my_offer), class: "btn btn-primary" %>
  <%= link_to "Back to my offers", my_offers_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this my offer", @my_offer, method: :delete, class: "btn btn-outline-danger" %>
</div>
