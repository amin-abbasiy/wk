<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
  <h1 class="h2 mb-0">My offers</h1>
  <%= link_to "New my offer", new_my_offer_path, class: "btn btn-primary" %>
</div>

<div class="row g-4">
  <% @my_offers.each do |my_offer| %>
    <div class="col-12 col-md-6">
      <%= render my_offer %>
    </div>
  <% end %>
</div>
