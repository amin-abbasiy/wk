<%= render @shift_shame %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this shift shame", edit_shift_shame_path(@shift_shame), class: "btn btn-primary" %>
