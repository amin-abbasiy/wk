<%= form_with(model: shift_shame) do |form| %>
  <%= render "layouts/shared/form_errors", record: shift_shame, resource_name: "shift_shame" %>

  <div class="mb-3">
    <%= form.label :emotion_behind_shame, class: "form-label" %>
    <%= form.cktext_area :emotion_behind_shame, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :seperate_people_story, class: "form-label" %>
    <%= form.cktext_area :seperate_people_story, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :shift_to_appriciaton, class: "form-label" %>
    <%= form.cktext_area :shift_to_appriciaton, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :uncover_emotion_root, class: "form-label" %>
    <%= form.cktext_area :uncover_emotion_root, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :realign_with_values, class: "form-label" %>
    <%= form.cktext_area :realign_with_values, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
