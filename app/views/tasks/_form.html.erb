<%= form_with(model: task) do |form| %>
  <%= render "layouts/shared/form_errors", record: task, resource_name: "task" %>

  <div class="row mb-3">
    <%= form.label :weekly_plan_id, class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10">
      <%= form.select :weekly_plan_id, WeeklyPlan.all.map { |wp| [wp.title, wp.id] }, {}, class: 'form-select' %>
    </div>
  </div>

  <div class="row mb-3">
    <%= form.label :name, for: "inputName1", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10">
      <%= form.text_field :name, class: 'form-control', id: "inputName1" %>
    </div>
  </div>

  <div class="row mb-3">
    <%= form.label :interval, for: "inputName2", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10">
      <%= form.number_field :interval, class: 'form-control', id: "inputName2" %>
    </div>
  </div>

  <div class="row mb-3">
    <%= form.label :start_time, for: "inputName3", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10">
      <%= form.datetime_field :start_time, class: 'form-control', id: "inputName3" %>
    </div>
  </div>

  <div class="row mb-3">
    <%= form.label :end_time, for: "inputName4", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10">
      <%= form.datetime_field :end_time, class: 'form-control', id: "inputName4" %>
    </div>
  </div>

  <div class="row mb-3">
    <%= form.label :duration, for: "inputName5", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10">
      <%= form.number_field :duration, class: 'form-control', id: "inputName5" %>
    </div>
  </div>

  <div class="row mb-3">
    <%= form.label :status, for: "inputName6", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10">
      <%= form.number_field :status, class: 'form-control', id: "inputName6" %>
    </div>
  </div>

  <div class="row mb-3">
    <%= form.label :feelings, for: "inputName7", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10">
      <%= form.cktext_area :feelings, class: 'form-control', id: "inputName7" %>
    </div>
  </div>

  <div class="mt-4">
    <%= form.submit "Create Task", class: "btn btn-primary" %>
  </div>
<% end %>
