<%= render @comment %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this comment", edit_comment_path(@comment), class: "btn btn-primary" %>
  <%= link_to "Back to comments", comments_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this comment", @comment, method: :delete, class: "btn btn-outline-danger" %>
</div>
