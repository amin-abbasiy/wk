<%= render @learning %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this learning", edit_learning_path(@learning), class: "btn btn-primary" %>
  <%= link_to "Back to learnings", learnings_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this learning", @learning, method: :delete, class: "btn btn-outline-danger" %>
</div>
