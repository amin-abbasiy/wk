<%= form_with(model: learning) do |form| %>
  <% if learning.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(learning.errors.count, "error") %> prohibited this learning from being saved:</h2>

      <ul>
        <% learning.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :concepts, style: "display: block" %>
    <%= form.cktext_area :concepts %>
  </div>

  <div>
    <%= form.label :finished, style: "display: block" %>
    <%= form.check_box :finished %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
