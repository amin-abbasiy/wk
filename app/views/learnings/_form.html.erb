<%= form_with(model: learning) do |form| %>
  <%= render "layouts/shared/form_errors", record: learning, resource_name: "learning" %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :concepts, class: "form-label" %>
    <%= form.cktext_area :concepts, class: "form-control" %>
  </div>

  <div class="form-check mb-3">
    <%= form.check_box :finished, class: "form-check-input" %>
    <%= form.label :finished, class: "form-check-label" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
