<%= form_with(model: auto_suggestion) do |form| %>
  <%= render "layouts/shared/form_errors", record: auto_suggestion, resource_name: "auto_suggestion" %>

  <div class="mb-3">
    <%= form.label :idea, class: "form-label" %>
    <%= form.text_field :idea, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :faith, class: "form-label" %>
    <%= form.text_area :faith, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :plan, class: "form-label" %>
    <%= form.text_area :plan, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :action, class: "form-label" %>
    <%= form.text_area :action, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :persistence, class: "form-label" %>
    <%= form.text_area :persistence, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
