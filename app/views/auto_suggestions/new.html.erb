<%= render layout: "layouts/shared/form_page" do %>
  <h1 class="h2 fw-bold mb-4">New auto suggestion</h1>

  <%= render "form", auto_suggestion: @auto_suggestion %>

  <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
    <%= link_to "Back to auto suggestions", auto_suggestions_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
