<%= render @auto_suggestion %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this auto suggestion", edit_auto_suggestion_path(@auto_suggestion), class: "btn btn-primary" %>
  <%= link_to "Back to auto suggestions", auto_suggestions_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this auto suggestion", @auto_suggestion, method: :delete, class: "btn btn-outline-danger" %>
</div>
