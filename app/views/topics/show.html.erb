<%= render @topic %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this topic", edit_topic_path(@topic), class: "btn btn-primary" %>
  <%= link_to "Back to topics", topics_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this topic", @topic, method: :delete, class: "btn btn-outline-danger" %>
</div>
