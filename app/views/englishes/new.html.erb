<%= render layout: "layouts/shared/form_page" do %>
  <h1 class="h2 fw-bold mb-4">New english</h1>

  <%= turbo_frame_tag 'new_phrase', target: '_top' do %>
    <%= render "form", english: @english %>
  <% end %>

  <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
    <%= link_to "Back to englishes", englishes_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
