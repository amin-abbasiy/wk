<div class="row justify-content-center">
  <div class="col-12 col-lg-8 col-xl-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h4 card-title"><%= @english.word.html_safe %></h1>
        <hr>
        <%= @english.definition.html_safe %>
        <%= audio_tag(@english.audio, controls: true) if @english.audio.attached? %>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
          <%= link_to "Edit this english", edit_english_path(@english), class: 'btn btn-primary' %>
          <%= link_to "Back to englishes", englishes_path, "data-turbo-frame" => '_top', class: 'btn btn-outline-secondary' %>
          <%= button_to "Destroy this english", @english, method: :delete, class: 'btn btn-outline-danger' %>
        </div>
      </div>
    </div>
  </div>
</div>
