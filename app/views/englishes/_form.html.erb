<%= form_with(model: english) do |form| %>
  <%= render "layouts/shared/form_errors", record: english, resource_name: "english" %>

  <div class="mb-3">
    <%= form.label :word, class: "form-label" %>
    <%= form.text_field :word, class: 'form-control' %>
  </div>
  <div class="mt-4">
    <%= form.submit "Create New Phrase", class: 'btn btn-primary' %>
  </div>
<% end %>
