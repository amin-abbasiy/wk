<div class="col-md-4 mb-4">
  <div class="card h-300">
    <div class="card-body">
      <h5 class="card-title p-2"><%= english.word.html_safe %></h5><hr class="bg-black">
        <%= english.definition.html_safe %>
        <%= audio_tag(english.audio, controls: true) if english.audio.attached? %>
      <div class="d-flex justify-content-between">
        <%= button_to "Del", @english, method: :delete, class: 'btn btn-danger' %>
        <%= link_to "Show", english, class: 'btn btn-success' %>
      </div>
    </div>
  </div>
</div>


