<div class="card h-100 shadow-sm">
  <div class="card-body">
    <h2 class="h5 card-title"><%= english.word.html_safe %></h2>
    <hr>
    <%= english.definition.html_safe %>
    <%= audio_tag(english.audio, controls: true) if english.audio.attached? %>
    <div class="d-flex flex-wrap justify-content-between gap-2 mt-3">
      <%= button_to "Del", @english, method: :delete, class: 'btn btn-outline-danger btn-sm' %>
      <%= link_to "Show", english, class: 'btn btn-outline-primary btn-sm' %>
    </div>
  </div>
</div>
