<%= render layout: "layouts/shared/form_page" do %>
  <h1 class="h2 fw-bold mb-4">Editing english</h1>

  <%= render "form", english: @english %>

  <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
    <%= link_to "Show this english", @english, class: "btn btn-outline-primary" %>
    <%= link_to "Back to englishes", englishes_path, "data-turbo-frame" => '_top', class: "btn btn-outline-secondary" %>
  </div>
<% end %>
