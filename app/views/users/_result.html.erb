<div class="col-12 col-md-6 mb-4">
  <div class="card h-100 shadow-sm">
    <div class="card-body">
      <% record = result[:class_name].constantize.find(result[:id]) %>
      <div id="<%= record.id %>">

        <p>
          <strong>Type:</strong>
          <%= result[:class_name] %>
        </p>

        <p>
          <strong>Title:</strong>
          <%= record.id %>
        </p>

        <p>
          <%= link_to "View Details", result.class.name, class: 'btn btn-primary' %>
        </p>
      </div>
    </div>
  </div>
</div>
