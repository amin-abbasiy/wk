<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
  <h1 class="h2 mb-0">Email messages</h1>
  <%= link_to "New email message", new_email_message_path, class: "btn btn-primary" %>
</div>

<div class="row g-4">
  <% @email_messages.each do |email_message| %>
    <div class="col-12 col-md-6">
      <%= render email_message %>
    </div>
  <% end %>
</div>
