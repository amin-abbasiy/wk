<%= render @email_message %>

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
  <%= link_to "Edit this email message", edit_email_message_path(@email_message), class: "btn btn-primary" %>
  <%= link_to "Back to email messages", email_messages_path, class: "btn btn-outline-secondary" %>

  <%= button_to "Destroy this email message", @email_message, method: :delete, class: "btn btn-outline-danger" %>
</div>
