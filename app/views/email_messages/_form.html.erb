<%= form_with(model: email_message) do |form| %>
  <%= render "layouts/shared/form_errors", record: email_message, resource_name: "email_message" %>

  <div class="mb-3">
    <%= form.label :message, class: "form-label" %>
    <%= form.cktext_area :message, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :response, class: "form-label" %>
    <%= form.cktext_area :response, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
