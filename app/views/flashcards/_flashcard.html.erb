<div class="card card-body shadow-sm" id="<%= dom_id flashcard %>">
  <div class="mb-3">
    <strong>Content:</strong>
    <%= flashcard.content.html_safe %>
  </div>

  <div class="mb-3">
    <strong>Description:</strong>
    <%= flashcard.description.html_safe %>
  </div>

  <p>
    <strong>Status:</strong>
    <%= flashcard.status %>
  </p>

  <p>
    <strong>Repetition:</strong>
    <%= flashcard.repetition %>
  </p>

</div>
