<%= form_with(model: flashcard) do |form| %>
  <%= render "layouts/shared/form_errors", record: flashcard, resource_name: "flashcard" %>

  <div class="mb-3">
    <%= form.label :content, class: "form-label" %>
    <%= form.cktext_area :content, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.cktext_area :description, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :status, class: "form-label" %>
    <%= form.number_field :status, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :repetition, class: "form-label" %>
    <%= form.number_field :repetition, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
