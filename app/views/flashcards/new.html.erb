<%= render layout: "layouts/shared/form_page" do %>
  <h1 class="h2 fw-bold mb-4">New flashcard</h1>

  <%= render "form", flashcard: @flashcard %>

  <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
    <%= link_to "Back to flashcards", flashcards_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
